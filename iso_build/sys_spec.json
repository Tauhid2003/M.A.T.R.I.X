{
  "project_name": "M.A.T.R.I.X. AI-OS",
  "version": "1.0.0-alpha",
  "target_architecture": "x86_64",
  "base_distribution": "debian",
  "suite": "bookworm",
  "kernel": "linux-image-amd64",
  "optimization_flags": "-march=x86-64-v3 -O3",
  "packages_to_exclude": [
    "snapd",
    "gnome-shell",
    "gdm3",
    "popularity-contest",
    "ubuntu-report",
    "apport"
  ],
  "packages_to_include": [
    "linux-image-amd64",
    "linux-headers-amd64",
    "build-essential",
    "live-boot",
    "live-config",
    "live-config-systemd",
    "initramfs-tools",
    "grub-pc-bin",
    "grub-efi-amd64-bin",
    "firmware-linux-free",
    "firmware-linux-nonfree",
    "firmware-misc-nonfree",
    "firmware-iwlwifi",
    "firmware-realtek",
    "firmware-atheros",
    "firmware-brcm80211",
    "firmware-amd-graphics",
    "firmware-sof-signed",
    "intel-microcode",
    "amd64-microcode",
    "sudo",
    "systemd-sysv",
    "xorg",
    "xserver-xorg-input-libinput",
    "mate-desktop-environment-core",
    "xterm",
    "network-manager",
    "wpasupplicant",
    "wireless-tools",
    "isc-dhcp-client",
    "iproute2",
    "iputils-ping",
    "dnsutils",
    "nftables",
    "openssh-client",
    "openssh-server",
    "winehq-devel",
    "cabextract",
    "libgl1-mesa-dri",
    "libglx-mesa0",
    "mesa-utils",
    "mesa-vulkan-drivers",
    "vulkan-tools",
    "va-driver-all",
    "vdpau-driver-all",
    "pipewire-audio",
    "wireplumber",
    "alsa-utils",
    "pavucontrol",
    "bluez",
    "blueman",
    "cups",
    "cups-bsd",
    "printer-driver-all",
    "sane-airscan",
    "e2fsprogs",
    "dosfstools",
    "exfatprogs",
    "ntfs-3g",
    "btrfs-progs",
    "xfsprogs",
    "squashfs-tools",
    "lvm2",
    "cryptsetup",
    "acpi",
    "acpid",
    "upower",
    "power-profiles-daemon",
    "brightnessctl",
    "pciutils",
    "usbutils",
    "lshw",
    "htop",
    "less",
    "nano",
    "vim-tiny",
    "rsync",
    "zip",
    "unzip",
    "bash-completion",
    "locales",
    "tzdata",
    "python3",
    "python3-pip",
    "python3-websockets",
    "sqlite3",
    "espeak",
    "xdotool",
    "git",
    "curl",
    "bubblewrap",
    "apparmor",
    "apparmor-utils",
    "lightdm",
    "lightdm-gtk-greeter",
    "firefox-esr",
    "nodejs",
    "npm"
  ],
  "package_repositories": {
    "debian_components": [
      "main",
      "contrib",
      "non-free",
      "non-free-firmware"
    ],
    "runtime_network_required": false
  },
  "wine_compatibility_layer": {
    "enabled": true,
    "version": "devel",
    "dxvk_enabled": true,
    "ntsync_enabled": true
  },
  "local_ai_daemon": {
    "engine": "ollama",
    "baked_models": [
      "qwen3:8b"
    ],
    "optional_power_models": [
      "qwen3:30b",
      "qwen3-coder:30b",
      "llama3.3:70b"
    ],
    "context_window_tokens": 32768,
    "concurrency_limit": 4,
    "gpu_mode": "auto",
    "runtime_network_required": false,
    "default_orchestrator_model": "qwen3:8b",
    "offline_fallback_model": "matrix-local-synapse"
  },
  "ai_orchestration": {
    "enabled": true,
    "mode": "local-first",
    "allowed_actions": [
      "open_app",
      "run_diagnostics",
      "schedule_agent_task",
      "change_scheduler_policy",
      "query_core_status",
      "start_service",
      "stop_service"
    ],
    "requires_confirmation": [
      "build_iso",
      "install_package",
      "modify_boot_config",
      "start_network_service"
    ]
  },
  "security_sandboxing": {
    "default_mode": 2,
    "bubblewrap_enabled": true,
    "apparmor_enabled": true,
    "nftables_shield_enabled": true
  }
}
