{
  "project_name": "M.A.T.R.I.X. AI-OS",
  "version": "1.0.0-alpha",
  "target_architecture": "x86_64",
  "base_distribution": "debian",
  "suite": "bookworm",
  "kernel": "linux-image-amd64",
  "optimization_flags": "-march=x86-64-v3 -O3",
  "packages_to_exclude": [
    "snapd",
    "gnome-shell",
    "gdm3",
    "popularity-contest",
    "ubuntu-report",
    "apport"
  ],
  "packages_to_include": [
    "sudo",
    "systemd-sysv",
    "xorg",
    "mate-desktop-environment-core",
    "xterm",
    "winehq-devel",
    "libgl1-mesa-dri",
    "vulkan-tools",
    "python3",
    "python3-pip",
    "sqlite3",
    "espeak",
    "xdotool",
    "git",
    "curl"
  ],
  "wine_compatibility_layer": {
    "enabled": true,
    "version": "devel",
    "dxvk_enabled": true,
    "ntsync_enabled": true
  },
  "local_ai_daemon": {
    "engine": "ollama",
    "baked_models": [
      "qwen-2.5-3b-instruct-q4"
    ],
    "context_window_tokens": 32768,
    "concurrency_limit": 4,
    "gpu_mode": "cpu"
  },
  "security_sandboxing": {
    "default_mode": 2,
    "bubblewrap_enabled": true,
    "apparmor_enabled": true,
    "nftables_shield_enabled": true
  }
}
