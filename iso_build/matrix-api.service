[Unit]
Description=M.A.T.R.I.X. AI-OS System API Daemon
After=network.target local-fs.target matrix-daemon.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/api_daemon.py
Restart=always
RestartSec=5
User=matrix
Group=matrix
RuntimeDirectory=matrix
RuntimeDirectoryMode=0750

# Security hardening constraints for Systemd
ProtectSystem=strict
ReadWritePaths=/var/lib/matrix /var/log /tmp /run/matrix
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
CapabilityBoundingSet=
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
Alias=matrix-api.service
