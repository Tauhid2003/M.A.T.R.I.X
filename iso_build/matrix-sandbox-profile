# AppArmor profile for M.A.T.R.I.X sandbox container processes
# Permits access to core standard libraries while denying critical OS files and raw socket access.

abi <abi/3.5>,

include <tunables/global>

profile matrix-sandbox-profile flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # Allow execution of common shell utilities (ix forces inheriting this profile)
  /usr/bin/bash ix,
  /usr/bin/sh ix,
  /usr/bin/ls ix,
  /usr/bin/pwd ix,
  /usr/bin/whoami ix,
  /usr/bin/python3* ix,

  # Allow read-write access only to user sandbox folders and cache paths
  /var/lib/matrix/** rw,
  /home/matrix/** rw,
  /tmp/matrix_build/** rw,

  # Deny write access to critical OS config directories
  deny /etc/** w,
  deny /boot/** w,
  deny /var/log/** w,
  deny /dev/kmsg rw,

  # Deny execution of privilege escalation and dangerous binaries
  deny /usr/bin/sudo x,
  deny /usr/bin/su x,
  deny /usr/bin/mount x,
  deny /usr/bin/umount x,
  deny /usr/bin/apt x,
  deny /usr/bin/dpkg x,
  deny /usr/bin/systemctl x,
  deny /usr/bin/chown x,
  deny /usr/bin/chmod x,

  # Restrict low-level network sockets to block arbitrary outbound network egress
  deny network raw,
  deny network packet,
}
